# The variables LIVE mode reads. Live mode costs money. Offline mode needs none of this.
# No script in this repository loads a .env file, so copying this file to .env changes nothing:
# set a variable in the terminal you run the live command from, for example
#   export ANTHROPIC_API_KEY=...          (macOS / Linux)
#   $env:ANTHROPIC_API_KEY = "..."        (Windows PowerShell)
# Never commit a filled-in copy of this file.

# Offline (the default) or live. Anything other than "live" means offline.
RESEARCH_AGENT_RUN_MODE=offline

# Live mode, precondition 1 of 2: an Anthropic API key, OR a `claude` program on this machine that
# you have already logged in. One of the two is required; the key is the simpler one.
ANTHROPIC_API_KEY=

# Live mode, precondition 2 of 2: a machine where the SDK may start the `claude` program and write
# its session transcripts to disk. There is no environment variable for that one.
