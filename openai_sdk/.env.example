# Live mode only. The offline rungs (npm run rung0..rung3, npm test) need none of this.
#
# Set these ONLY if you have decided to send real requests to OpenAI. No script in this folder
# loads a .env file: set them in the terminal you run your live copy from, for example
#   export OPENAI_API_KEY=...          (macOS / Linux)
#   $env:OPENAI_API_KEY = "..."        (Windows PowerShell)
# Live requests cost money, billed to the account this key belongs to.
# Never commit a filled-in .env.

# Your own key, from your own OpenAI account.
OPENAI_API_KEY=

# Which model to use. You choose: models differ in price and in what they can do.
# Later rungs need a model that supports function tools and structured output.
OPENAI_MODEL=
