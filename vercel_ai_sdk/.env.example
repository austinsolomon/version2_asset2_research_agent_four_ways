# The variables LIVE mode reads, listed so you know what each one is for. You do not need any of
# them to run anything here. No script in this folder loads a .env file, so copying this file to
# .env changes nothing: set a variable in the terminal you run the rungs from instead, for example
#   export RESEARCH_AGENT_LIVE_MODE=on          (macOS / Linux)
#   $env:RESEARCH_AGENT_LIVE_MODE = "on"        (Windows PowerShell)
#
# Every value below is blank on purpose, and a blank value counts as unset. With nothing set, all
# four rungs run offline against the recordings in ../shared/fixtures/ and cost nothing.
#
# LIVE MODE COSTS MONEY. Each rung sends real requests to paid services, per bakery, every run.

# The master switch. Only the exact word "on" turns live mode on.
RESEARCH_AGENT_LIVE_MODE=

# The model key. One Vercel AI Gateway key covers every model provider, and the model id is a plain
# string in lib/modelSelection.ts. Needed by rungs 0, 1, 2 and 3 in live mode.
AI_GATEWAY_API_KEY=

# Live rung 1 and rung 2 read pages with a plain fetch(). A real product rents a scraping service
# here instead (see illustrative/rung1_live_firecrawl_tool.ts), which is what this key is for.
FIRECRAWL_API_KEY=

# Live search is NOT wired up in this teaching build: rung 2's search tool says so by name rather
# than returning nothing. illustrative/rung2_live_exa_search_tool.ts shows the shape.
EXA_API_KEY=
